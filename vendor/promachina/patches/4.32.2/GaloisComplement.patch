+/-- Transport the function facts returned after applying `FintypeCat.incl`
+back to the underlying functions of the original `FintypeCat` morphisms.
+Lean 4.32 distinguishes these two coercion paths even though their pointwise
+applications are the same. -/
+private theorem functionFactsOfIncl
+    {X Z Y : C} (i : X ⟶ Y) (u : Z ⟶ Y)
+    (facts :
+      Function.Injective (ConcreteCategory.hom (F.map i).hom) ∧
+        Function.Injective (ConcreteCategory.hom (F.map u).hom) ∧
+        IsCompl
+          (Set.range (ConcreteCategory.hom (F.map i).hom))
+          (Set.range (ConcreteCategory.hom (F.map u).hom))) :
+    Function.Injective (F.map i) ∧
+      Function.Injective (F.map u) ∧
+      IsCompl (Set.range (F.map i)) (Set.range (F.map u)) := by
+  have rangeI :
+      Set.range (ConcreteCategory.hom (F.map i).hom) =
+        Set.range (ConcreteCategory.hom (F.map i)) := by
+    ext value
+    constructor <;> rintro ⟨preimage, equality⟩ <;>
+      exact ⟨preimage, equality⟩
+  have rangeU :
+      Set.range (ConcreteCategory.hom (F.map u).hom) =
+        Set.range (ConcreteCategory.hom (F.map u)) := by
+    ext value
+    constructor <;> rintro ⟨preimage, equality⟩ <;>
+      exact ⟨preimage, equality⟩
+  refine ⟨?_, ?_, ?_⟩
+  · intro first second equality
+    exact facts.1 equality
+  · intro first second equality
+    exact facts.2.1 equality
+  · rw [← rangeI, ← rangeU]
+    exact facts.2.2
+
