import Mathlib.Algebra.Group.TypeTags.Basic
import Mathlib.Algebra.Group.TypeTags.Finite
import Mathlib.Algebra.Group.ULift
import Mathlib.Data.ZMod.Basic
import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.GroupTheory.QuotientGroup.Basic
import Mathlib.Topology.Algebra.Category.ProfiniteGrp.Basic
import Mathlib.Topology.Algebra.Group.Extension

/-!
# Group-theoretic quotients from Etale Theta, Section 2

This file formalizes the algebraic part of the construction preceding
`Etale Theta`, Definition 2.1. It does not assert that these quotients have
already been realized by finite etale covers of an orbicurve.
-/

open Function
open CategoryTheory
open scoped commutatorElement IsMulCommutative

namespace Iut.EtaleTheta

universe u

section LowerCentral

variable (G : Type u) [Group G]

/-- The commutator subgroup `[G,G]`. -/
abbrev derivedSubgroup : Subgroup G :=
  commutator G

/-- The third term `[G,[G,G]]` of the lower central series. -/
def thetaCommutatorKernel : Subgroup G :=
  ⁅(⊤ : Subgroup G), derivedSubgroup G⁆

instance thetaCommutatorKernel_normal :
    (thetaCommutatorKernel G).Normal := by
  change ⁅(⊤ : Subgroup G), commutator G⁆.Normal
  infer_instance

/-- The two-step nilpotent theta quotient `G/[G,[G,G]]`. -/
abbrev ThetaQuotient :=
  G ⧸ thetaCommutatorKernel G

/-- The elliptic abelianization `G/[G,G]`. -/
abbrev EllipticAbelianization :=
  G ⧸ derivedSubgroup G

theorem thetaCommutatorKernel_le_derivedSubgroup :
    thetaCommutatorKernel G ≤ derivedSubgroup G :=
  Subgroup.commutator_le_right _ _

/-- The canonical projection from the theta quotient to the abelianization. -/
def thetaToElliptic :
    ThetaQuotient G →* EllipticAbelianization G :=
  QuotientGroup.map
    (thetaCommutatorKernel G)
    (derivedSubgroup G)
    (MonoidHom.id G)
    (thetaCommutatorKernel_le_derivedSubgroup G)

theorem thetaToElliptic_mk (g : G) :
    thetaToElliptic G (QuotientGroup.mk g) = QuotientGroup.mk g :=
  rfl

/-- The normal subgroup generated by the `l`-th powers in the theta quotient. -/
def lPowerKernel (l : ℕ) : Subgroup (ThetaQuotient G) :=
  Subgroup.normalClosure {x | ∃ y : ThetaQuotient G, x = y ^ l}

instance lPowerKernel_normal (l : ℕ) :
    (lPowerKernel G l).Normal :=
  Subgroup.normalClosure_normal

/-- The exponent-`l` theta quotient used in the construction before Definition 2.1. -/
abbrev ModLThetaQuotient (l : ℕ) :=
  ThetaQuotient G ⧸ lPowerKernel G l

/-- The canonical projection from the geometric fundamental group. -/
def modLThetaProjection (l : ℕ) :
    G →* ModLThetaQuotient G l :=
  (QuotientGroup.mk' (lPowerKernel G l)).comp
    (QuotientGroup.mk' (thetaCommutatorKernel G))

theorem modLThetaProjection_surjective (l : ℕ) :
    Surjective (modLThetaProjection G l) :=
  (QuotientGroup.mk'_surjective _).comp
    (QuotientGroup.mk'_surjective _)

theorem lth_power_maps_to_one (l : ℕ) (x : ThetaQuotient G) :
    QuotientGroup.mk (x ^ l) = (1 : ModLThetaQuotient G l) := by
  apply (QuotientGroup.eq_one_iff (x ^ l)).mpr
  exact Subgroup.subset_normalClosure ⟨x, rfl⟩

/-- The normal subgroup generated by `l`-th powers in the elliptic abelianization. -/
def ellipticLPowerKernel (l : ℕ) : Subgroup (EllipticAbelianization G) :=
  Subgroup.normalClosure
    {x | ∃ y : EllipticAbelianization G, x = y ^ l}

instance ellipticLPowerKernel_normal (l : ℕ) :
    (ellipticLPowerKernel G l).Normal :=
  Subgroup.normalClosure_normal

/--
The mod-`l` elliptic quotient. For a once-punctured elliptic curve this is the
rank-two module `(Z/lZ)^2` denoted `Delta_X^ell` in Etale Theta, Section 2.
-/
abbrev ModLEllipticAbelianization (l : ℕ) :=
  EllipticAbelianization G ⧸ ellipticLPowerKernel G l

/-- The canonical projection from a group to its mod-`l` abelianization. -/
def modLEllipticProjection (l : ℕ) :
    G →* ModLEllipticAbelianization G l :=
  (QuotientGroup.mk' (ellipticLPowerKernel G l)).comp
    (QuotientGroup.mk' (derivedSubgroup G))

theorem modLEllipticProjection_surjective (l : ℕ) :
    Surjective (modLEllipticProjection G l) :=
  (QuotientGroup.mk'_surjective _).comp
    (QuotientGroup.mk'_surjective _)

theorem thetaToElliptic_maps_lPowerKernel (l : ℕ) :
    lPowerKernel G l ≤
      (ellipticLPowerKernel G l).comap (thetaToElliptic G) := by
  apply Subgroup.normalClosure_le_normal
  rintro x ⟨y, rfl⟩
  change thetaToElliptic G (y ^ l) ∈ ellipticLPowerKernel G l
  rw [map_pow]
  exact Subgroup.subset_normalClosure
    ⟨thetaToElliptic G y, rfl⟩

/--
The canonical surjection
`Delta_X^Theta/l-powers -> Delta_X^ell/l-powers`.
-/
def modLThetaToElliptic (l : ℕ) :
    ModLThetaQuotient G l →* ModLEllipticAbelianization G l :=
  QuotientGroup.map
    (lPowerKernel G l)
    (ellipticLPowerKernel G l)
    (thetaToElliptic G)
    (thetaToElliptic_maps_lPowerKernel G l)

@[simp]
theorem modLThetaToElliptic_mk (l : ℕ) (x : ThetaQuotient G) :
    modLThetaToElliptic G l (QuotientGroup.mk x) =
      QuotientGroup.mk (thetaToElliptic G x) :=
  rfl

theorem thetaToElliptic_surjective :
    Surjective (thetaToElliptic G) := by
  intro x
  refine QuotientGroup.induction_on x ?_
  intro g
  exact ⟨QuotientGroup.mk g, rfl⟩

/-- The integral theta direction `Delta^Theta`: the kernel of the canonical
two-step-nilpotent quotient map to the elliptic abelianization. -/
def ThetaCenter : Subgroup (ThetaQuotient G) :=
  (thetaToElliptic G).ker

instance thetaCenter_normal : (ThetaCenter G).Normal := by
  change (thetaToElliptic G).ker.Normal
  infer_instance

/-- The integral theta direction is central in the two-step nilpotent
theta quotient. This is the lower-central-series reason that the kernel of
`thetaToElliptic` is the theta center, rather than merely a normal subgroup. -/
theorem thetaCenter_le_center :
    ThetaCenter G ≤ Subgroup.center (ThetaQuotient G) := by
  intro z hz
  rw [Subgroup.mem_center_iff]
  obtain ⟨g, rfl⟩ :=
    QuotientGroup.mk'_surjective (thetaCommutatorKernel G) z
  have hg : g ∈ derivedSubgroup G := by
    apply (QuotientGroup.eq_one_iff g).mp
    exact hz
  intro q
  refine QuotientGroup.induction_on q ?_
  intro h
  apply commutatorElement_eq_one_iff_mul_comm.mp
  change QuotientGroup.mk' (thetaCommutatorKernel G) ⁅h, g⁆ = 1
  apply (QuotientGroup.eq_one_iff (⁅h, g⁆ : G)).mpr
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top h) hg

/-- The integral theta center is commutative because it lies in the center of
the two-step nilpotent quotient. -/
instance thetaCenter_isMulCommutative :
    IsMulCommutative (ThetaCenter G) where
  is_comm := ⟨by
      intro first second
      apply Subtype.ext
      exact
        (Subgroup.mem_center_iff.mp
          (thetaCenter_le_center G first.2) second.1).symm⟩

/-- The subgroup `l * Delta^Theta`, constructed as the literal image of the
`l`-th-power homomorphism on the integral theta direction. This is distinct
from the finite center of the exponent-`l` theta quotient. -/
def LDeltaTheta (l : ℕ) : Subgroup (ThetaQuotient G) :=
  MonoidHom.range
    ((ThetaCenter G).subtype.comp
      (powMonoidHom l : ThetaCenter G →* ThetaCenter G))

/-- Every `l`-multiple theta element remains in the integral theta center. -/
theorem lDeltaTheta_le_thetaCenter (l : ℕ) :
    LDeltaTheta G l ≤ ThetaCenter G := by
  rintro value ⟨center, rfl⟩
  exact (ThetaCenter G).pow_mem center.2 l

/-- Consequently, `l * Delta^Theta` is itself central in the theta quotient. -/
theorem lDeltaTheta_le_center (l : ℕ) :
    LDeltaTheta G l ≤ Subgroup.center (ThetaQuotient G) :=
  (lDeltaTheta_le_thetaCenter G l).trans (thetaCenter_le_center G)

instance lDeltaTheta_normal (l : ℕ) : (LDeltaTheta G l).Normal where
  conj_mem value hvalue conjugator := by
    have hcommutes : conjugator * value = value * conjugator :=
      Subgroup.mem_center_iff.mp
        (lDeltaTheta_le_center G l hvalue) conjugator
    rw [hcommutes, mul_assoc, mul_inv_cancel, mul_one]
    exact hvalue

/-- The canonical projection `Delta_X -> Delta_X^Theta`. -/
def thetaProjection : G →* ThetaQuotient G :=
  QuotientGroup.mk' (thetaCommutatorKernel G)

/-- The numerator in `Delta_X` whose theta-quotient image lies in
`l * Delta^Theta`. -/
def LDeltaThetaNumerator (l : ℕ) : Subgroup G :=
  Subgroup.comap (thetaProjection G) (LDeltaTheta G l)

/-- The exact lower-central denominator, restricted to the
`l * Delta^Theta` numerator. -/
def LDeltaThetaDenominator (l : ℕ) :
    Subgroup (LDeltaThetaNumerator G l) :=
  Subgroup.comap
    (LDeltaThetaNumerator G l).subtype
    (thetaCommutatorKernel G)

instance lDeltaThetaDenominator_normal (l : ℕ) :
    (LDeltaThetaDenominator G l).Normal := by
  change
    (Subgroup.comap
      (LDeltaThetaNumerator G l).subtype
      (thetaCommutatorKernel G)).Normal
  infer_instance

/-- The literal algebraic subquotient representing `l * Delta^Theta`. -/
abbrev LDeltaThetaSubquotient (l : ℕ) :=
  LDeltaThetaNumerator G l ⧸ LDeltaThetaDenominator G l

/-- Projection of the pulled-back numerator onto the actual
`l * Delta^Theta` subgroup. -/
def lDeltaThetaProjection (l : ℕ) :
    LDeltaThetaNumerator G l →* LDeltaTheta G l where
  toFun source := ⟨thetaProjection G source.1, source.2⟩
  map_one' := by
    apply Subtype.ext
    exact map_one (thetaProjection G)
  map_mul' first second := by
    apply Subtype.ext
    exact map_mul (thetaProjection G) first.1 second.1

@[simp]
theorem lDeltaThetaProjection_apply
    (l : ℕ) (source : LDeltaThetaNumerator G l) :
    (lDeltaThetaProjection G l source).1 = thetaProjection G source.1 :=
  rfl

/-- The lower-central denominator is exactly the kernel of the restricted
projection. -/
theorem lDeltaThetaProjection_ker (l : ℕ) :
    (lDeltaThetaProjection G l).ker =
      LDeltaThetaDenominator G l := by
  ext source
  simp only [MonoidHom.mem_ker]
  change
    lDeltaThetaProjection G l source = 1 ↔
      source.1 ∈ thetaCommutatorKernel G
  constructor
  · intro hsource
    exact
      (QuotientGroup.eq_one_iff source.1).mp
        (congrArg Subtype.val hsource)
  · intro hsource
    apply Subtype.ext
    exact (QuotientGroup.eq_one_iff source.1).mpr hsource

/-- The restricted projection is onto `l * Delta^Theta`. -/
theorem lDeltaThetaProjection_surjective (l : ℕ) :
    Surjective (lDeltaThetaProjection G l) := by
  intro target
  obtain ⟨source, hsource⟩ :=
    QuotientGroup.mk'_surjective (thetaCommutatorKernel G) target.1
  refine ⟨⟨source, ?_⟩, ?_⟩
  · change
      QuotientGroup.mk' (thetaCommutatorKernel G) source ∈
        LDeltaTheta G l
    rw [hsource]
    exact target.2
  · apply Subtype.ext
    exact hsource

/-- The first isomorphism theorem identifies the literal pulled-back quotient
with the actual integral `l * Delta^Theta` subgroup. -/
noncomputable def lDeltaThetaSubquotientEquiv (l : ℕ) :
    LDeltaThetaSubquotient G l ≃* LDeltaTheta G l :=
  (QuotientGroup.quotientMulEquivOfEq
      (lDeltaThetaProjection_ker G l).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective
      (lDeltaThetaProjection G l)
      (lDeltaThetaProjection_surjective G l))

theorem modLThetaToElliptic_surjective (l : ℕ) :
    Surjective (modLThetaToElliptic G l) := by
  intro x
  refine QuotientGroup.induction_on x ?_
  intro y
  obtain ⟨z, rfl⟩ := thetaToElliptic_surjective G y
  exact ⟨QuotientGroup.mk z, rfl⟩

/--
The central theta direction `Delta^Theta`, defined as the kernel of the
canonical map to the mod-`l` elliptic quotient.
-/
def ModLThetaCenter (l : ℕ) :
    Subgroup (ModLThetaQuotient G l) :=
  (modLThetaToElliptic G l).ker

instance modLThetaCenter_normal (l : ℕ) :
    (ModLThetaCenter G l).Normal := by
  change (modLThetaToElliptic G l).ker.Normal
  infer_instance

/-- The quotient by the theta center is the mod-`l` elliptic quotient. -/
noncomputable def modLThetaQuotientByCenterEquiv (l : ℕ) :
    ModLThetaQuotient G l ⧸ ModLThetaCenter G l ≃*
      ModLEllipticAbelianization G l :=
  QuotientGroup.quotientKerEquivOfSurjective
    (modLThetaToElliptic G l)
    (modLThetaToElliptic_surjective G l)

end LowerCentral

section ProfiniteLowerCentral

/-!
## Profinite realization of the lower-central quotients

The algebraic constructions above are useful independently of topology.  The
canonical Etale Theta source path, however, starts from a profinite geometric
fundamental group.  For a general profinite group it is not a formal consequence
of the group axioms that the abstract commutator and power subgroups used above
are closed.  The following certificate records that the four canonical quotient
topologies are profinite; closedness then follows because each subgroup is the
kernel of its continuous quotient map.

Requiring this certificate at the source boundary prevents an arbitrary bare
group, or an arbitrary nonclosed normal subgroup, from entering the canonical
coefficient construction.
-/

/-- Topological certification for the algebraic lower-central and exponent-`l`
quotients of a profinite group.  The quotient topologies are Mathlib's canonical
quotient topologies; no independently supplied topology is accepted. -/
structure ProfiniteLowerCentralTopology
    (l : ℕ) (G : ProfiniteGrp.{u}) where
  thetaQuotient_totallyDisconnected :
    TotallyDisconnectedSpace (ThetaQuotient G)
  ellipticAbelianization_totallyDisconnected :
    TotallyDisconnectedSpace (EllipticAbelianization G)
  modLThetaQuotient_totallyDisconnected :
    TotallyDisconnectedSpace (ModLThetaQuotient G l)
  modLEllipticAbelianization_totallyDisconnected :
    TotallyDisconnectedSpace (ModLEllipticAbelianization G l)

namespace ProfiniteLowerCentralTopology

variable {l : ℕ} {G : ProfiniteGrp.{u}}
variable (topology : ProfiniteLowerCentralTopology l G)

include topology

/-- The third lower-central subgroup is closed, as the kernel of the
continuous map to the certified profinite theta quotient. -/
theorem thetaCommutatorKernel_isClosed :
    IsClosed ((thetaCommutatorKernel G : Subgroup G) : Set G) := by
  letI : TotallyDisconnectedSpace (ThetaQuotient G) :=
    ProfiniteLowerCentralTopology.thetaQuotient_totallyDisconnected topology
  rw [← QuotientGroup.ker_mk' (thetaCommutatorKernel G)]
  change IsClosed {source : G | thetaProjection G source = 1}
  exact isClosed_singleton.preimage QuotientGroup.continuous_mk

/-- The commutator subgroup is closed, as the kernel of the continuous map to
the certified profinite elliptic quotient. -/
theorem derivedSubgroup_isClosed :
    IsClosed ((derivedSubgroup G : Subgroup G) : Set G) := by
  letI : TotallyDisconnectedSpace (EllipticAbelianization G) :=
    ProfiniteLowerCentralTopology.ellipticAbelianization_totallyDisconnected topology
  rw [← QuotientGroup.ker_mk' (derivedSubgroup G)]
  change IsClosed
    {source : G | QuotientGroup.mk' (derivedSubgroup G) source = 1}
  exact isClosed_singleton.preimage QuotientGroup.continuous_mk

/-- The theta power kernel is closed, as the kernel of the continuous map to
the certified profinite exponent-`l` theta quotient. -/
theorem lPowerKernel_isClosed :
    IsClosed ((lPowerKernel G l : Subgroup (ThetaQuotient G)) :
      Set (ThetaQuotient G)) := by
  letI : TotallyDisconnectedSpace (ThetaQuotient G) :=
    ProfiniteLowerCentralTopology.thetaQuotient_totallyDisconnected topology
  letI : TotallyDisconnectedSpace (ModLThetaQuotient G l) :=
    ProfiniteLowerCentralTopology.modLThetaQuotient_totallyDisconnected topology
  rw [← QuotientGroup.ker_mk' (lPowerKernel G l)]
  change IsClosed
    {source : ThetaQuotient G |
      QuotientGroup.mk' (lPowerKernel G l) source = 1}
  exact isClosed_singleton.preimage QuotientGroup.continuous_mk

/-- The elliptic power kernel is closed, as the kernel of the continuous map
to the certified profinite exponent-`l` elliptic quotient. -/
theorem ellipticLPowerKernel_isClosed :
    IsClosed ((ellipticLPowerKernel G l :
      Subgroup (EllipticAbelianization G)) :
      Set (EllipticAbelianization G)) := by
  letI : TotallyDisconnectedSpace (EllipticAbelianization G) :=
    ProfiniteLowerCentralTopology.ellipticAbelianization_totallyDisconnected topology
  letI : TotallyDisconnectedSpace (ModLEllipticAbelianization G l) :=
    ProfiniteLowerCentralTopology.modLEllipticAbelianization_totallyDisconnected topology
  rw [← QuotientGroup.ker_mk' (ellipticLPowerKernel G l)]
  change IsClosed
    {source : EllipticAbelianization G |
      QuotientGroup.mk' (ellipticLPowerKernel G l) source = 1}
  exact isClosed_singleton.preimage QuotientGroup.continuous_mk

/-- The class-two theta quotient with its certified profinite topology. -/
noncomputable def thetaQuotientProfiniteGrp : ProfiniteGrp.{u} := by
  letI : TotallyDisconnectedSpace (ThetaQuotient G) :=
    topology.thetaQuotient_totallyDisconnected
  exact ProfiniteGrp.of (ThetaQuotient G)

/-- The elliptic abelianization with its certified profinite topology. -/
noncomputable def ellipticAbelianizationProfiniteGrp : ProfiniteGrp.{u} := by
  letI : TotallyDisconnectedSpace (EllipticAbelianization G) :=
    topology.ellipticAbelianization_totallyDisconnected
  exact ProfiniteGrp.of (EllipticAbelianization G)

/-- The exponent-`l` theta quotient with its certified profinite topology. -/
noncomputable def modLThetaQuotientProfiniteGrp : ProfiniteGrp.{u} := by
  letI : TotallyDisconnectedSpace (ThetaQuotient G) :=
    topology.thetaQuotient_totallyDisconnected
  letI : TotallyDisconnectedSpace (ModLThetaQuotient G l) :=
    topology.modLThetaQuotient_totallyDisconnected
  exact ProfiniteGrp.of (ModLThetaQuotient G l)

/-- The exponent-`l` elliptic quotient with its certified profinite topology. -/
noncomputable def modLEllipticAbelianizationProfiniteGrp : ProfiniteGrp.{u} := by
  letI : TotallyDisconnectedSpace (EllipticAbelianization G) :=
    topology.ellipticAbelianization_totallyDisconnected
  letI : TotallyDisconnectedSpace (ModLEllipticAbelianization G l) :=
    topology.modLEllipticAbelianization_totallyDisconnected
  exact ProfiniteGrp.of (ModLEllipticAbelianization G l)

/-- The canonical theta projection as a morphism of profinite groups. -/
noncomputable def thetaProjectionHom :
    G ⟶ topology.thetaQuotientProfiniteGrp :=
  ConcreteCategory.ofHom
    { toMonoidHom := thetaProjection G
      continuous_toFun := QuotientGroup.continuous_mk }

/-- The canonical elliptic projection as a morphism of profinite groups. -/
noncomputable def ellipticProjectionHom :
    G ⟶ topology.ellipticAbelianizationProfiniteGrp :=
  ConcreteCategory.ofHom
    { toMonoidHom := QuotientGroup.mk' (derivedSubgroup G)
      continuous_toFun := QuotientGroup.continuous_mk }

/-- The canonical exponent-`l` theta projection as a profinite morphism. -/
noncomputable def modLThetaProjectionHom :
    topology.thetaQuotientProfiniteGrp ⟶
      topology.modLThetaQuotientProfiniteGrp :=
  ConcreteCategory.ofHom
    { toMonoidHom := QuotientGroup.mk' (lPowerKernel G l)
      continuous_toFun := QuotientGroup.continuous_mk }

/-- The canonical exponent-`l` elliptic projection as a profinite morphism. -/
noncomputable def modLEllipticProjectionHom :
    topology.ellipticAbelianizationProfiniteGrp ⟶
      topology.modLEllipticAbelianizationProfiniteGrp :=
  ConcreteCategory.ofHom
    { toMonoidHom := QuotientGroup.mk' (ellipticLPowerKernel G l)
      continuous_toFun := QuotientGroup.continuous_mk }

/-- The composite geometric projection `Delta -> Delta^Theta/l` as a
profinite morphism. -/
noncomputable def geometricModLThetaProjectionHom :
    G ⟶ topology.modLThetaQuotientProfiniteGrp :=
  topology.thetaProjectionHom ≫ topology.modLThetaProjectionHom

/-- The composite geometric projection `Delta -> Delta^ell/l` as a profinite
morphism. -/
noncomputable def geometricModLEllipticProjectionHom :
    G ⟶ topology.modLEllipticAbelianizationProfiniteGrp :=
  topology.ellipticProjectionHom ≫ topology.modLEllipticProjectionHom

@[simp]
theorem geometricModLThetaProjectionHom_apply (source : G) :
    topology.geometricModLThetaProjectionHom source =
      modLThetaProjection G l source :=
  rfl

@[simp]
theorem geometricModLEllipticProjectionHom_apply (source : G) :
    topology.geometricModLEllipticProjectionHom source =
      modLEllipticProjection G l source :=
  rfl

theorem thetaProjectionHom_surjective :
    Function.Surjective topology.thetaProjectionHom :=
  QuotientGroup.mk'_surjective _

theorem ellipticProjectionHom_surjective :
    Function.Surjective topology.ellipticProjectionHom :=
  QuotientGroup.mk'_surjective _

theorem modLThetaProjectionHom_surjective :
    Function.Surjective topology.modLThetaProjectionHom :=
  by
    intro target
    refine QuotientGroup.induction_on target ?_
    intro source
    exact ⟨source, rfl⟩

theorem modLEllipticProjectionHom_surjective :
    Function.Surjective topology.modLEllipticProjectionHom :=
  by
    intro target
    refine QuotientGroup.induction_on target ?_
    intro source
    exact ⟨source, rfl⟩

theorem geometricModLThetaProjectionHom_surjective :
    Function.Surjective topology.geometricModLThetaProjectionHom :=
  topology.modLThetaProjectionHom_surjective.comp
    topology.thetaProjectionHom_surjective

theorem geometricModLEllipticProjectionHom_surjective :
    Function.Surjective topology.geometricModLEllipticProjectionHom :=
  topology.modLEllipticProjectionHom_surjective.comp
    topology.ellipticProjectionHom_surjective

omit topology in
/-- The theta-to-elliptic factor map is continuous for the quotient topologies. -/
theorem continuous_thetaToElliptic :
    Continuous (thetaToElliptic G) := by
  apply (QuotientGroup.isQuotientMap_mk
    (thetaCommutatorKernel G)).continuous_iff.mpr
  exact QuotientGroup.continuous_mk

/-- The theta-to-elliptic map as a morphism of profinite groups. -/
noncomputable def thetaToEllipticHom :
    topology.thetaQuotientProfiniteGrp ⟶
      topology.ellipticAbelianizationProfiniteGrp :=
  ConcreteCategory.ofHom
    { toMonoidHom := thetaToElliptic G
      continuous_toFun := continuous_thetaToElliptic (G := G) }

omit topology in
/-- The exponent-`l` theta-to-elliptic factor map is continuous. -/
theorem continuous_modLThetaToElliptic :
    Continuous (modLThetaToElliptic G l) := by
  apply (QuotientGroup.isQuotientMap_mk
    (lPowerKernel G l)).continuous_iff.mpr
  exact QuotientGroup.continuous_mk.comp
    (continuous_thetaToElliptic (G := G))

/-- The exponent-`l` theta-to-elliptic map as a profinite morphism. -/
noncomputable def modLThetaToEllipticHom :
    topology.modLThetaQuotientProfiniteGrp ⟶
      topology.modLEllipticAbelianizationProfiniteGrp :=
  ConcreteCategory.ofHom
    { toMonoidHom := modLThetaToElliptic G l
      continuous_toFun := continuous_modLThetaToElliptic (G := G) (l := l) }

include topology

/-- The theta quotient is a topological short exact quotient by the closed
third lower-central subgroup. -/
theorem thetaQuotient_isSES :
    TopologicalGroup.IsSES
      (thetaCommutatorKernel G).subtype
      (thetaProjection G) :=
  TopologicalGroup.IsSES.ofClosedSubgroup
    (thetaCommutatorKernel G)
    (ProfiniteLowerCentralTopology.thetaCommutatorKernel_isClosed topology)

/-- The elliptic abelianization is a topological short exact quotient by the
closed commutator subgroup. -/
theorem ellipticAbelianization_isSES :
    TopologicalGroup.IsSES
      (derivedSubgroup G).subtype
      (QuotientGroup.mk' (derivedSubgroup G)) :=
  TopologicalGroup.IsSES.ofClosedSubgroup
    (derivedSubgroup G)
    (ProfiniteLowerCentralTopology.derivedSubgroup_isClosed topology)

/-- The exponent-`l` theta quotient is a topological short exact quotient. -/
theorem modLThetaQuotient_isSES :
    TopologicalGroup.IsSES
      (lPowerKernel G l).subtype
      (QuotientGroup.mk' (lPowerKernel G l)) :=
  TopologicalGroup.IsSES.ofClosedSubgroup
    (lPowerKernel G l)
    (ProfiniteLowerCentralTopology.lPowerKernel_isClosed topology)

/-- The exponent-`l` elliptic quotient is a topological short exact quotient. -/
theorem modLEllipticAbelianization_isSES :
    TopologicalGroup.IsSES
      (ellipticLPowerKernel G l).subtype
      (QuotientGroup.mk' (ellipticLPowerKernel G l)) :=
  TopologicalGroup.IsSES.ofClosedSubgroup
    (ellipticLPowerKernel G l)
    (ProfiniteLowerCentralTopology.ellipticLPowerKernel_isClosed topology)

/-- The theta center is closed because it is the kernel of the continuous
theta-to-elliptic morphism. -/
theorem thetaCenter_isClosed :
    IsClosed ((ThetaCenter G : Subgroup (ThetaQuotient G)) :
      Set (ThetaQuotient G)) := by
  letI : TotallyDisconnectedSpace (EllipticAbelianization G) :=
    topology.ellipticAbelianization_totallyDisconnected
  change IsClosed {x : ThetaQuotient G | thetaToElliptic G x = 1}
  exact isClosed_singleton.preimage (continuous_thetaToElliptic (G := G))

/-- The first-isomorphism identification of the quotient by the integral theta
center with the elliptic abelianization is a homeomorphism. -/
noncomputable def thetaQuotientByCenterContinuousMulEquiv :
    ThetaQuotient G ⧸ ThetaCenter G ≃ₜ*
      topology.ellipticAbelianizationProfiniteGrp := by
  letI : TotallyDisconnectedSpace (ThetaQuotient G) :=
    topology.thetaQuotient_totallyDisconnected
  letI : TotallyDisconnectedSpace (EllipticAbelianization G) :=
    topology.ellipticAbelianization_totallyDisconnected
  let equivalence :
      ThetaQuotient G ⧸ ThetaCenter G ≃*
        EllipticAbelianization G :=
    QuotientGroup.quotientKerEquivOfSurjective
      (thetaToElliptic G) (thetaToElliptic_surjective G)
  have continuous_equivalence : Continuous equivalence := by
    apply (QuotientGroup.isQuotientMap_mk
      (ThetaCenter G)).continuous_iff.mpr
    change Continuous (equivalence ∘ QuotientGroup.mk)
    convert continuous_thetaToElliptic (G := G) using 1
  exact
    { toMulEquiv := equivalence
      continuous_toFun := continuous_equivalence
      continuous_invFun :=
        Continuous.continuous_symm_of_equiv_compact_to_t2
          continuous_equivalence }

/-- The integral theta-center sequence is exact in topological groups. -/
theorem thetaCenter_isSES :
    TopologicalGroup.IsSES
      (ThetaCenter G).subtype
      (thetaToElliptic G) := by
  let equivalence := topology.thetaQuotientByCenterContinuousMulEquiv
  refine
    { isClosedEmbedding :=
        ⟨⟨Topology.IsInducing.subtypeVal,
            (ThetaCenter G).subtype_injective⟩,
          by simpa using topology.thetaCenter_isClosed⟩
      isOpenQuotientMap := ?_
      mulExact := by
        intro source
        constructor
        · intro hsource
          exact ⟨⟨source, hsource⟩, rfl⟩
        · rintro ⟨center, rfl⟩
          exact center.2 }
  have quotient_then_equivalence :
      IsOpenQuotientMap
        (equivalence ∘
          (QuotientGroup.mk :
            ThetaQuotient G →
              ThetaQuotient G ⧸ ThetaCenter G)) :=
    equivalence.toHomeomorph.isOpenQuotientMap.comp
      QuotientGroup.isOpenQuotientMap_mk
  convert quotient_then_equivalence using 1

/-- The kernel of the composite exponent-`l` theta projection is closed. -/
theorem modLThetaProjection_ker_isClosed :
    IsClosed (((modLThetaProjection G l).ker : Subgroup G) : Set G) := by
  letI : TotallyDisconnectedSpace (ModLThetaQuotient G l) :=
    topology.modLThetaQuotient_totallyDisconnected
  change IsClosed {source : G | modLThetaProjection G l source = 1}
  exact isClosed_singleton.preimage
    topology.geometricModLThetaProjectionHom.hom.continuous_toFun

/-- The kernel of the composite exponent-`l` elliptic projection is closed. -/
theorem modLEllipticProjection_ker_isClosed :
    IsClosed (((modLEllipticProjection G l).ker : Subgroup G) : Set G) := by
  letI : TotallyDisconnectedSpace (ModLEllipticAbelianization G l) :=
    topology.modLEllipticAbelianization_totallyDisconnected
  change IsClosed {source : G | modLEllipticProjection G l source = 1}
  exact isClosed_singleton.preimage
    topology.geometricModLEllipticProjectionHom.hom.continuous_toFun

/-- The integral subgroup `l * Delta^Theta` is closed: it is the compact image
of the power map on the closed theta center. -/
theorem lDeltaTheta_isClosed :
    IsClosed ((LDeltaTheta G l : Subgroup (ThetaQuotient G)) :
      Set (ThetaQuotient G)) := by
  letI : TotallyDisconnectedSpace (ThetaQuotient G) :=
    topology.thetaQuotient_totallyDisconnected
  letI : CompactSpace (ThetaCenter G) :=
    (topology.thetaCenter_isClosed).isClosedEmbedding_subtypeVal.compactSpace
  change IsClosed (Set.range
    (fun center : ThetaCenter G => (center.1 : ThetaQuotient G) ^ l))
  exact (isCompact_range (continuous_subtype_val.pow l)).isClosed

/-- The pulled-back numerator for `l * Delta^Theta` is closed in the original
profinite geometric group. -/
theorem lDeltaThetaNumerator_isClosed :
    IsClosed ((LDeltaThetaNumerator G l : Subgroup G) : Set G) := by
  change IsClosed ((thetaProjection G) ⁻¹'
    ((LDeltaTheta G l : Subgroup (ThetaQuotient G)) :
      Set (ThetaQuotient G)))
  exact (topology.lDeltaTheta_isClosed).preimage QuotientGroup.continuous_mk

/-- The exact lower-central denominator is closed in the pulled-back
`l * Delta^Theta` numerator. -/
theorem lDeltaThetaDenominator_isClosed :
    IsClosed ((LDeltaThetaDenominator G l :
      Subgroup (LDeltaThetaNumerator G l)) :
      Set (LDeltaThetaNumerator G l)) := by
  change IsClosed
    ((LDeltaThetaNumerator G l).subtype ⁻¹'
      ((thetaCommutatorKernel G : Subgroup G) : Set G))
  exact (ProfiniteLowerCentralTopology.thetaCommutatorKernel_isClosed topology).preimage
    continuous_subtype_val

/-- The closed integral theta coefficient subgroup inside the profinite theta
quotient. -/
noncomputable def lDeltaThetaClosedSubgroup :
    ClosedSubgroup topology.thetaQuotientProfiniteGrp where
  toSubgroup := LDeltaTheta G l
  isClosed' := topology.lDeltaTheta_isClosed

/-- The integral theta coefficient as an actual profinite group. -/
noncomputable def lDeltaThetaProfiniteGrp : ProfiniteGrp.{u} :=
  ProfiniteGrp.ofClosedSubgroup topology.lDeltaThetaClosedSubgroup

omit topology
/-- The restricted projection from the pulled-back numerator to the closed
integral theta coefficient is continuous. -/
theorem continuous_lDeltaThetaProjection :
    Continuous (lDeltaThetaProjection G l) := by
  apply Continuous.subtype_mk
  exact QuotientGroup.continuous_mk.comp continuous_subtype_val

include topology

/-- The first-isomorphism identification of the literal source subquotient
with `l * Delta^Theta` is a homeomorphism. -/
noncomputable def lDeltaThetaSubquotientContinuousMulEquiv :
    LDeltaThetaSubquotient G l ≃ₜ*
      topology.lDeltaThetaProfiniteGrp := by
  letI : TotallyDisconnectedSpace (ThetaQuotient G) :=
    topology.thetaQuotient_totallyDisconnected
  letI : CompactSpace (LDeltaThetaNumerator G l) :=
    topology.lDeltaThetaNumerator_isClosed
      |>.isClosedEmbedding_subtypeVal.compactSpace
  let continuous_equiv :
      Continuous (lDeltaThetaSubquotientEquiv G l) := by
    apply (QuotientGroup.isQuotientMap_mk
      (LDeltaThetaDenominator G l)).continuous_iff.mpr
    change Continuous
      (lDeltaThetaSubquotientEquiv G l ∘ QuotientGroup.mk)
    convert continuous_lDeltaThetaProjection (G := G) (l := l) using 1
  exact
    { toMulEquiv := lDeltaThetaSubquotientEquiv G l
      continuous_toFun := continuous_equiv
      continuous_invFun :=
        Continuous.continuous_symm_of_equiv_compact_to_t2 continuous_equiv }

/-- The topological first-isomorphism map agrees with the restricted quotient
projection on representatives. -/
@[simp]
theorem lDeltaThetaSubquotientContinuousMulEquiv_projection
    (source : LDeltaThetaNumerator G l) :
    topology.lDeltaThetaSubquotientContinuousMulEquiv
        (QuotientGroup.mk source) =
      lDeltaThetaProjection G l source :=
  rfl

end ProfiniteLowerCentralTopology

end ProfiniteLowerCentral

section Lagrangian

/-- The multiplicative presentation of the additive rank-one module `Z/lZ`. -/
abbrev LTorsionLabel (l : ℕ) :=
  Multiplicative (ZMod l)

/-- A universe lift of the finite `Z/lZ` label group. -/
abbrev LiftedLTorsionLabel (l : ℕ) :=
  ULift.{u} (LTorsionLabel l)

/--
The source rank assertions for the lower-central quotient of the geometric
fundamental group of a once-punctured elliptic curve.

The quotient groups are derived above. These equivalences record the genuinely
geometric input that the theta center has rank one and the elliptic quotient
has rank two over `Z/lZ`; they are not inferred from cardinalities.
-/
structure OncePuncturedEllipticThetaRealization
    (l : ℕ) (Delta : Type u) [Group Delta] where
  thetaCenter :
    ModLThetaCenter Delta l ≃*
      LTorsionLabel l
  ellipticDirections :
    ModLEllipticAbelianization Delta l ≃*
      LTorsionLabel l × LTorsionLabel l

namespace OncePuncturedEllipticThetaRealization

variable {l : ℕ} {Delta : Type u} [Group Delta]

theorem thetaCenter_rankOne
    (realization : OncePuncturedEllipticThetaRealization l Delta) :
    Nonempty
      (ModLThetaCenter Delta l ≃*
        LTorsionLabel l) :=
  ⟨OncePuncturedEllipticThetaRealization.thetaCenter realization⟩

theorem ellipticDirections_rankTwo
    (realization : OncePuncturedEllipticThetaRealization l Delta) :
    Nonempty
      (ModLEllipticAbelianization Delta l ≃*
        LTorsionLabel l × LTorsionLabel l) :=
  ⟨OncePuncturedEllipticThetaRealization.ellipticDirections realization⟩

end OncePuncturedEllipticThetaRealization

/-- Remove the universe lift from an `l`-torsion label. -/
def liftedLTorsionEquiv (l : ℕ) :
    LiftedLTorsionLabel.{u} l ≃* LTorsionLabel l :=
  MulEquiv.ulift

/-- The finite discrete profinite group underlying the rank-one module `Z/lZ`. -/
def lTorsionProfiniteGroup (l : ℕ) [NeZero l] : ProfiniteGrp.{u} :=
  ProfiniteGrp.ofFiniteGrp (FiniteGrp.of (LiftedLTorsionLabel.{u} l))

/--
The precise group-theoretic input called a quotient `Pi_X^ell -> Q` in the
construction preceding Etale Theta, Definition 2.1.

The quotient is onto a rank-one `Z/lZ`; its restriction to the geometric
subgroup remains onto, while it is trivial on the cuspidal decomposition group.
-/
structure LagrangianQuotient
    (l : ℕ) (Pi : Type u) [Group Pi] where
  geometricSubgroup : Subgroup Pi
  cuspDecompositionGroup : Subgroup Pi
  quotient : Pi →* LTorsionLabel l
  quotient_surjective : Surjective quotient
  geometric_surjective :
    Surjective (quotient.comp geometricSubgroup.subtype)
  cusp_trivial :
    cuspDecompositionGroup ≤ quotient.ker

namespace LagrangianQuotient

variable {l : ℕ} {Pi : Type u} [Group Pi]
variable (Q : LagrangianQuotient l Pi)

/-- The normal open-subgroup candidate corresponding to the `Q`-cover. -/
def coverSubgroup : Subgroup Pi :=
  Q.quotient.ker

instance coverSubgroup_normal :
    Q.coverSubgroup.Normal := by
  change Q.quotient.ker.Normal
  infer_instance

/-- The first-isomorphism-theorem identification `Pi/ker(Q) = Z/lZ`. -/
noncomputable def coverQuotientEquiv :
    Pi ⧸ Q.coverSubgroup ≃* LTorsionLabel l :=
  QuotientGroup.quotientKerEquivOfSurjective
    Q.quotient Q.quotient_surjective

theorem cuspDecompositionGroup_le_coverSubgroup :
    Q.cuspDecompositionGroup ≤ Q.coverSubgroup :=
  Q.cusp_trivial

theorem geometricRestriction_surjective :
    Surjective (Q.quotient.comp Q.geometricSubgroup.subtype) :=
  Q.geometric_surjective

end LagrangianQuotient

/--
The topological refinement of a Lagrangian quotient: a continuous surjection
from a profinite arithmetic group onto the finite discrete group `Z/lZ`.
-/
structure ProfiniteLagrangianQuotient
    (l : ℕ) [NeZero l] (Pi : ProfiniteGrp.{u}) where
  geometricSubgroup : Subgroup Pi
  cuspDecompositionGroup : Subgroup Pi
  quotient : Pi ⟶ lTorsionProfiniteGroup l
  quotient_surjective : Surjective quotient
  geometric_surjective :
    Surjective
      ((liftedLTorsionEquiv l).toMonoidHom.comp
        (quotient.hom.toMonoidHom.comp geometricSubgroup.subtype))
  cusp_trivial :
    cuspDecompositionGroup ≤ quotient.hom.ker

namespace ProfiniteLagrangianQuotient

variable {l : ℕ} [NeZero l] {Pi : ProfiniteGrp.{u}}
variable (Q : ProfiniteLagrangianQuotient l Pi)

/-- The underlying quotient homomorphism after removing the universe lift. -/
def underlyingQuotient :
    Pi →* LTorsionLabel l :=
  (liftedLTorsionEquiv l).toMonoidHom.comp Q.quotient.hom.toMonoidHom

/-- Forgetting topology recovers the algebraic Lagrangian quotient. -/
def toLagrangianQuotient :
    LagrangianQuotient l Pi where
  geometricSubgroup := Q.geometricSubgroup
  cuspDecompositionGroup := Q.cuspDecompositionGroup
  quotient := Q.underlyingQuotient
  quotient_surjective :=
    (liftedLTorsionEquiv l).surjective.comp Q.quotient_surjective
  geometric_surjective := Q.geometric_surjective
  cusp_trivial := by
    intro x hx
    change Q.underlyingQuotient x = 1
    have hq : Q.quotient x = 1 := Q.cusp_trivial hx
    exact (liftedLTorsionEquiv l).map_eq_one_iff.mpr hq

/-- The kernel subgroup corresponding to the finite profinite cover. -/
def coverSubgroup : Subgroup Pi :=
  Q.underlyingQuotient.ker

instance coverSubgroup_normal :
    Q.coverSubgroup.Normal := by
  change Q.underlyingQuotient.ker.Normal
  infer_instance

theorem coverSubgroup_isOpen :
    IsOpen ((Q.coverSubgroup : Subgroup Pi) : Set Pi) := by
  have hset :
      {x : Pi | Q.underlyingQuotient x = 1} =
        {x : Pi | Q.quotient x = 1} := by
    ext x
    change
      (liftedLTorsionEquiv l) (Q.quotient x) = 1 ↔
        Q.quotient x = 1
    exact (liftedLTorsionEquiv l).map_eq_one_iff
  change IsOpen {x : Pi | Q.underlyingQuotient x = 1}
  rw [hset]
  have hopen :
      IsOpen ({1} : Set (lTorsionProfiniteGroup l)) := by
    change @IsOpen (LiftedLTorsionLabel.{u} l) ⊥ {1}
    letI : TopologicalSpace (LiftedLTorsionLabel.{u} l) := ⊥
    letI : DiscreteTopology (LiftedLTorsionLabel.{u} l) := ⟨rfl⟩
    exact isOpen_discrete _
  exact hopen.preimage Q.quotient.hom.continuous

/-- The quotient kernel is an actual open embedding into the arithmetic group. -/
def coverOpenEmbedding :
    Topology.IsOpenEmbedding
      (Q.coverSubgroup.subtype : Q.coverSubgroup → Pi) :=
  Q.coverSubgroup_isOpen.isOpenEmbedding_subtypeVal

/-- The first-isomorphism theorem for the continuous finite quotient. -/
noncomputable def coverQuotientEquiv :
    Pi ⧸ Q.coverSubgroup ≃* LTorsionLabel l :=
  Q.toLagrangianQuotient.coverQuotientEquiv

end ProfiniteLagrangianQuotient

/-- An actual order-two automorphism of the arithmetic group lifting elliptic inversion. -/
structure InversionAction (Pi : Type u) [Group Pi] where
  automorphism : Pi ≃* Pi
  involutive : automorphism.trans automorphism = MulEquiv.refl Pi

namespace InversionAction

variable {Pi : Type u} [Group Pi]
variable (inversion : InversionAction Pi)

theorem apply_apply (g : Pi) :
    inversion.automorphism (inversion.automorphism g) = g := by
  have h := DFunLike.congr_fun inversion.involutive g
  simpa using h

end InversionAction

/--
Compatibility of inversion with a Lagrangian quotient: the induced action on
`Q = Z/lZ` is multiplication by `-1`.
-/
structure InversionCompatibleLagrangian
    (l : ℕ) (Pi : Type u) [Group Pi]
    (Q : LagrangianQuotient l Pi)
    (inversion : InversionAction Pi) where
  quotient_inversion :
    ∀ g : Pi, Q.quotient (inversion.automorphism g) = (Q.quotient g)⁻¹

namespace InversionCompatibleLagrangian

variable {l : ℕ} {Pi : Type u} [Group Pi]
variable {Q : LagrangianQuotient l Pi}
variable {inversion : InversionAction Pi}
theorem coverSubgroup_invariant
    (compatibility : InversionCompatibleLagrangian l Pi Q inversion)
    {g : Pi} (hg : g ∈ Q.coverSubgroup) :
    inversion.automorphism g ∈ Q.coverSubgroup := by
  rw [LagrangianQuotient.coverSubgroup, MonoidHom.mem_ker] at hg ⊢
  rw [InversionCompatibleLagrangian.quotient_inversion compatibility, hg, inv_one]

end InversionCompatibleLagrangian

end Lagrangian

section SignLabels

variable {Q : Type u} [CommGroup Q]

/-- The nonidentity elements of a pointed multiplicative quotient `Q`. -/
abbrev NonzeroLabel (Q : Type u) [CommGroup Q] :=
  {x : Q // x ≠ 1}

namespace NonzeroLabel

instance : Inv (NonzeroLabel Q) where
  inv x :=
    ⟨x.1⁻¹, fun h => x.2 (inv_eq_one.mp h)⟩

@[simp]
theorem val_inv (x : NonzeroLabel Q) :
    ((x⁻¹ : NonzeroLabel Q) : Q) = (x : Q)⁻¹ :=
  rfl

@[simp]
theorem inv_inv (x : NonzeroLabel Q) :
    x⁻¹⁻¹ = x := by
  apply Subtype.ext
  simp

end NonzeroLabel

/-- The relation identifying a nonzero label with its inverse. -/
def signRel (x y : NonzeroLabel Q) : Prop :=
  x = y ∨ x = y⁻¹

theorem signRel_refl (x : NonzeroLabel Q) :
    signRel x x :=
  Or.inl rfl

theorem signRel_symm {x y : NonzeroLabel Q} :
    signRel x y → signRel y x := by
  rintro (h | h)
  · exact Or.inl h.symm
  · exact Or.inr (by simp [h])

theorem signRel_trans {x y z : NonzeroLabel Q} :
    signRel x y → signRel y z → signRel x z := by
  rintro (hxy | hxy) (hyz | hyz)
  · exact Or.inl (hxy.trans hyz)
  · exact Or.inr (hxy.trans hyz)
  · exact Or.inr (hxy.trans (congrArg Inv.inv hyz))
  · exact Or.inl (hxy.trans (congrArg Inv.inv hyz) |>.trans (NonzeroLabel.inv_inv z))

/-- The sign-orbit set `(Q \ {1})/{q ~ q^-1}` used to label quotient cusps. -/
def signSetoid (Q : Type u) [CommGroup Q] : Setoid (NonzeroLabel Q) where
  r := signRel
  iseqv := ⟨signRel_refl, signRel_symm, signRel_trans⟩

/-- Nonzero `Q`-labels modulo the involution induced by elliptic inversion. -/
abbrev SignLabel (Q : Type u) [CommGroup Q] :=
  Quotient (signSetoid Q)

def toSignLabel (x : NonzeroLabel Q) : SignLabel Q :=
  Quotient.mk (signSetoid Q) x

theorem toSignLabel_inv (x : NonzeroLabel Q) :
    toSignLabel x⁻¹ = toSignLabel x :=
  Quotient.sound (Or.inr rfl)

end SignLabels

end Iut.EtaleTheta
